DATABASE_URL=postgres://lead:local-development-only@127.0.0.1:54329/lead_intelligence
# For Neon, use the pooled URL above and set this to the direct URL for migrations.
MIGRATION_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
STORAGE_DIR=./storage
# Set COOKIE_SECURE=true behind HTTPS; never host production over HTTP.
COOKIE_SECURE=false
# For a live LINE Messaging API channel, set both values from LINE Developers.
# Expose POST /api/line/webhook over public HTTPS before enabling the webhook.
LINE_CHANNEL_SECRET=
LINE_DESTINATION_ID=
# OpenAI Responses API. No call is made without a server-side API key.
# Customer text sent for classification is redacted; kNN segment naming sends aggregate summaries only.
AI_SEGMENT_ENABLED=false
OPENAI_API_KEY=
# Optional: point to a non-synced server-side key file instead of putting the key in .env.
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5-mini
# One-time CLI setup: supply ADMIN_USERNAME and ADMIN_PASSWORD in your shell.
# No default administrator is created.
